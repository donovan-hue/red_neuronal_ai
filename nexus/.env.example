# Referencia de variables de entorno. El programa no carga archivos .env automáticamente.
# Exporta las variables desde el entorno de despliegue o el shell.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NEXUS_API_TOKEN=
NEXUS_ADMIN_TOKEN=
# Opcional: ruta absoluta al archivo de usuarios. Requiere HTTPS fuera de localhost.
NEXUS_AUTH_FILE=
# Opcional: SQLite local compartido entre procesos del mismo host.
NEXUS_RATE_DB=
# Opcional: número máximo de llamadas a proveedores por día UTC; exige NEXUS_RATE_DB.
NEXUS_API_DAILY_CALL_LIMIT=
